# JARVIS Backend Environment
APP_NAME=JARVIS Android Backend
APP_VERSION=2.2.0
ENV=production
SECRET_KEY=change-me-to-a-strong-secret-key-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers (at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=jarvis-auto

# Database
DATABASE_URL=sqlite+aiosqlite:///./jarvis.db
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=*

# Speech
STT_PROVIDER=whisper
TTS_PROVIDER=coqui

# Device
DEVICE_WS_TOKEN=jarvis-device-token
MAX_WS_CONNECTIONS=100
